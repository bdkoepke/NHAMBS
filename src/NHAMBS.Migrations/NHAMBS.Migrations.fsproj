<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);0020</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.404" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Migrations/M001_InitialSchema.fs" />
    <Compile Include="Migrations/M002_DashboardViews.fs" />
    <Compile Include="Migrations/M003_ChtOutstandingHistory.fs" />
    <Compile Include="Migrations/M004_DataAnomalies.fs" />
    <Compile Include="Migrations/M005_MedallionArchitecture.fs" />
    <Compile Include="Migrations/M006_ReferenceEntities.fs" />
    <Compile Include="Migrations/M007_MoveGoldViewsToNhambs.fs" />
    <Compile Include="Migrations/M008_IssuerAliases.fs" />
    <Compile Include="Migrations/M009_SilverCompatibilityViews.fs" />
    <Compile Include="Migrations/M010_PostgresFuzzyAliases.fs" />
    <Compile Include="Migrations/M011_FuzzyAliasGuard.fs" />
    <Compile Include="Migrations/M012_RawAndNhambs.fs" />
    <Compile Include="Migrations/M013_ReferenceDimensions.fs" />
    <Compile Include="Migrations/M014_Arrears.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentMigrator" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="8.0.1" />
    <PackageReference Include="Npgsql" Version="9.0.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
</Project>
