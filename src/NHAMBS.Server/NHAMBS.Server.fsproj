<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <RootNamespace>NHAMBS.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.404" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('wwwroot')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Saturn" Version="0.17.0" />
    <PackageReference Include="Fable.Remoting.Giraffe" Version="6.1.0" />
    <PackageReference Include="Fable.Remoting.Json" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NHAMBS.Shared\NHAMBS.Shared.fsproj" />
    <ProjectReference Include="..\NHAMBS.Data\NHAMBS.Data.fsproj" />
  </ItemGroup>
</Project>
