<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>NHAMBS.Circular</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.404" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Schema.fs" />
    <Compile Include="Circular.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Data" Version="8.2.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="schema/cmhc-2834-i-v2-extended-en.provider.schema.json" />
    <EmbeddedResource Include="schema/cmhc-2834-i-v2-extended-en.provider.schema.json"
                      LogicalName="NHAMBS.Circular.schema.cmhc-2834-i-v2-extended-en.provider.schema.json" />
    <EmbeddedResource Include="schema/cmhc-2834-i-v2-extended-en.schema.json"
                      LogicalName="NHAMBS.Circular.cmhc-2834-i-v2-extended-en.schema.json" />
  </ItemGroup>

</Project>
