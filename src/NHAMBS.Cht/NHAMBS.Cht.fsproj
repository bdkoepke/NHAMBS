<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>NHAMBS.Cht</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.404" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Schema.fs" />
    <Compile Include="DebtIssues.fs" />
    <Compile Include="OfferingCircular.fs" />
    <Compile Include="OutstandingHistory.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Data" Version="8.2.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="schema/cmhc-cht-debt-issues.provider.schema.json" />
    <EmbeddedResource Include="schema/cmhc-cht-debt-issues.provider.schema.json"
                      LogicalName="NHAMBS.Cht.schema.cmhc-cht-debt-issues.provider.schema.json" />
    <EmbeddedResource Include="schema/cmhc-cht-debt-issues.schema.json"
                      LogicalName="NHAMBS.Cht.cmhc-cht-debt-issues.schema.json" />
    <None Include="schema/cmhc-cht-offering-circular.provider.schema.json" />
    <EmbeddedResource Include="schema/cmhc-cht-offering-circular.provider.schema.json"
                      LogicalName="NHAMBS.Cht.schema.cmhc-cht-offering-circular.provider.schema.json" />
    <EmbeddedResource Include="schema/cmhc-cht-offering-circular.schema.json"
                      LogicalName="NHAMBS.Cht.cmhc-cht-offering-circular.schema.json" />
    <None Include="schema/cmhc-cht-outstanding-history.provider.schema.json" />
    <EmbeddedResource Include="schema/cmhc-cht-outstanding-history.provider.schema.json"
                      LogicalName="NHAMBS.Cht.schema.cmhc-cht-outstanding-history.provider.schema.json" />
    <EmbeddedResource Include="schema/cmhc-cht-outstanding-history.schema.json"
                      LogicalName="NHAMBS.Cht.cmhc-cht-outstanding-history.schema.json" />
  </ItemGroup>

</Project>
