# Local development database (matches the Pulumi Docker stack)
NHAMBS_CONNECTION=Host=localhost;Port=54322;Database=nhambs;Username=nhambs;Password=nhambs

# Optional: forward curve JSON path (defaults to out/forward_curves.json, then
# forward_curves.json in the repository root)
# NHAMBS_FORWARD_CURVES=/path/to/forward_curves.json

# Elsa Server + Studio (http://localhost:8090)
NHAMBS_ELSA_ADMIN_USER=admin
NHAMBS_ELSA_ADMIN_PASSWORD=nhambs-elsa-admin
NHAMBS_ELSA_SIGNING_KEY=nhambs-local-elsa-signing-key-change-me-before-deploying
